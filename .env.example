# Kvaradona V3 - local POC credentials
# Fill in .env, not this tracked example. Leave unavailable/optional values empty.
# The application and worker share this root configuration; live calls require durable budget authorization.
# Only the two NEXT_PUBLIC_ values are needed by the hosted review app.

# Core: OpenAI
OPENAI_API_KEY=

# Core: isolated hosted Supabase V3 project
# Project URL and publishable key may be used by the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. Never put this in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Core: discovery and company/contact data
BRAVE_SEARCH_API_KEY=
APOLLO_API_KEY=
THEIRSTACK_API_KEY=

# Selective enrichment: optional until that adapter is connected
# PredictLeads requires both its API key and API token.
# https://docs.predictleads.com/guide/similar_companies_dataset/api_endpoints
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=

# Optional: source comparison, US procurement, performance checks
HIREBASE_API_KEY=
SAM_GOV_API_KEY=
PAGESPEED_API_KEY=

# Later: Microsoft 365 delegated OAuth for approved sends and reply tracking
# Leave blank until the mail integration is configured.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# Use the app secret VALUE, not its identifier. Tokens are handled by OAuth later.
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_SENDER_EMAIL=

# No Trigger.dev key is needed: the worker runs on your laptop.
